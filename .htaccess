# Manual Apache fallback only.
# On Hostinger Node.js hosting, do not upload this file. Hostinger writes
# its own .htaccess and assigns PORT. This copy proxies to port 3000.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Never publish secrets or dependencies if the proxy is off
  RewriteRule (^|/)\.env - [F,L]
  RewriteRule ^node_modules(/|$) - [F,L]
  RewriteRule ^prisma(/|$) - [F,L]
  RewriteRule ^\.git(/|$) - [F,L]

  # Shopify compliance webhook is registered as compliance.php.
  # The app route is /webhooks/compliance. Keep the raw POST body.
  RewriteRule ^webhooks/compliance\.php$ http://127.0.0.1:3000/webhooks/compliance [P,L,QSA]

  # Dashboard, auth, privacy, and other routes all live in Node.
  # Port 3000 matches the app default. Change it if Hostinger assigns another PORT.
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L,QSA]
</IfModule>

# Shopify embedded auth sends a Bearer token. Apache drops it unless this is on.
CGIPassAuth On

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_headers.c>
  RequestHeader set X-Forwarded-Proto "https"
</IfModule>
