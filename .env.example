DATABASE_URL="file:./dev.sqlite"

# Shopify CLI usually injects these during `npm run dev`:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=
# SHOPIFY_APP_URL=

# Production (PostgreSQL):
# 1. Set provider = "postgresql" in prisma/schema.prisma
# 2. DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/whatsapp_int?sslmode=require
# 3. NODE_ENV=production
