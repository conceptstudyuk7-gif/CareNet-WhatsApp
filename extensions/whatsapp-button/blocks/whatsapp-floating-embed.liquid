{% liquid
  assign backend_phone = blank
  assign backend_default_message = blank
  assign backend_button_label = blank
  if app.metafields.whatsapp
    if app.metafields.whatsapp.phone_number
      assign backend_phone = app.metafields.whatsapp.phone_number.value
    endif
    if app.metafields.whatsapp.default_message
      assign backend_default_message = app.metafields.whatsapp.default_message.value
    endif
    if app.metafields.whatsapp.button_label
      assign backend_button_label = app.metafields.whatsapp.button_label.value
    endif
  elsif app.metafields["app--whatsapp"]
    if app.metafields["app--whatsapp"]["phone_number"]
      assign backend_phone = app.metafields["app--whatsapp"]["phone_number"].value
    endif
    if app.metafields["app--whatsapp"]["default_message"]
      assign backend_default_message = app.metafields["app--whatsapp"]["default_message"].value
    endif
    if app.metafields["app--whatsapp"]["button_label"]
      assign backend_button_label = app.metafields["app--whatsapp"]["button_label"].value
    endif
  endif

  assign phone = backend_phone
  assign phone = phone | strip | remove: " " | remove: "-" | remove: "+" | remove: "(" | remove: ")"
  assign default_message = backend_default_message | default: "Hi, I need help."
  assign button_label = backend_button_label | default: "Chat on WhatsApp"
  assign encoded_default_message = default_message | url_encode
  assign wa_link = "https://wa.me/" | append: phone | append: "?text=" | append: encoded_default_message
  assign app_enabled = true
  if app.metafields.whatsapp and app.metafields.whatsapp.enabled
    assign enabled_value = app.metafields.whatsapp.enabled.value | downcase | strip
    if enabled_value == "false"
      assign app_enabled = false
    endif
  elsif app.metafields["app--whatsapp"] and app.metafields["app--whatsapp"]["enabled"]
    assign enabled_value = app.metafields["app--whatsapp"]["enabled"].value | downcase | strip
    if enabled_value == "false"
      assign app_enabled = false
    endif
  endif
%}

{% if phone != blank and app_enabled %}
  <a
    href="{{ wa_link }}"
    class="wa-global-button"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ button_label | escape }}"
    title="{{ button_label | escape }}"
    {{ block.shopify_attributes }}
  >
    <span class="wa-global-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <path
          fill="currentColor"
          d="M20.52 3.48A11.86 11.86 0 0 0 12.07 0C5.5 0 .16 5.35.16 11.92c0 2.1.55 4.16 1.59 5.98L0 24l6.29-1.65a11.9 11.9 0 0 0 5.78 1.48h.01c6.57 0 11.92-5.35 11.92-11.92 0-3.18-1.24-6.16-3.48-8.43Zm-8.45 18.33h-.01a9.95 9.95 0 0 1-5.07-1.39l-.36-.21-3.73.98 1-3.64-.23-.37a9.92 9.92 0 0 1-1.53-5.27c0-5.48 4.46-9.94 9.94-9.94 2.65 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.91 7.01c0 5.48-4.46 9.94-9.93 9.94Zm5.45-7.44c-.3-.15-1.79-.88-2.07-.98-.28-.1-.48-.15-.69.15-.2.3-.79.98-.96 1.18-.18.2-.35.22-.65.08-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.08-.15-.69-1.66-.95-2.28-.25-.6-.5-.52-.69-.53l-.58-.01c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.14 4.54.72.31 1.29.5 1.73.64.73.23 1.4.2 1.93.12.59-.09 1.79-.73 2.04-1.44.25-.71.25-1.31.18-1.44-.08-.13-.28-.2-.58-.35Z"
        />
      </svg>
    </span>
  </a>
{% endif %}

{% style %}
  .wa-global-button {
    position: fixed;
    right: 18px !important;
    bottom: 18px !important;
    z-index: 99999 !important;
    width: 60px !important;
    height: 60px !important;
    padding: 0 !important;
    border: 2px solid #ffffff !important;
    border-radius: 999px !important;
    background: {{ block.settings.button_color }} !important;
    color: {{ block.settings.text_color }} !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.2);
    text-decoration: none;
    line-height: 0 !important;
    font-size: 0 !important;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .wa-global-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 24px rgba(0, 0, 0, 0.24);
  }

  .wa-global-icon {
    width: 30px;
    height: 30px;
    display: inline-flex;
    color: currentColor !important;
  }

  .wa-global-icon svg {
    width: 100%;
    height: 100%;
  }
{% endstyle %}

{% schema %}
{
  "name": "WhatsApp Floating Button",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Number, message, and label are controlled from the app dashboard. You can only change the button colors here."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
